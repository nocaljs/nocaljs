    "build": "webpack",
    "cdn:deploy": "make cdn"
  },
  "private": true,
  "author": "Johan Van den Brande",
  "license": "MIT",
  "keywords": [
    "reactive",
    "framework",
    "minimal",
    "state-management",
    "dom",
    "router",
    "web-components",
    "data-model",
    "hash-router",
    "nocaljs",
    "lightweight",
    "reactivity",
    "frontend-framework",
    "component-based"
  ],
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "marked": "^15.0.7",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "shelljs": "^0.9.2"
  }
}
