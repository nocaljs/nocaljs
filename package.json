{
  "name": "nocaljs",
  "version": "1.0.0",
  "description": "nocaljs is a lightweight reactive framework with built-in utilities. It provides DOM manipulation, state management, a hash-based router, a reactive data model, and support for web components",
  "private": true,
  "author": "Johan Van den Brande",
  "license": "MIT",
  "keywords": [
    "reactive",
    "framework",
    "minimal",
    "state-management",
    "dom",
    "router",
    "web-components",
    "data-model",
    "hash-router",
    "nocaljs",
    "lightweight",
    "reactivity",
    "frontend-framework",
    "component-based"
  ],
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "10.0.1",
    "copy-webpack-plugin": "13.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "http-server": "14.1.1",
    "linkedom": "0.18.12",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1"
  },
  "scripts": {
    "start": "http-server . -c-1",
    "test": "npm run test --workspaces --if-present && node --test tests/*.test.mjs",
    "test:artifacts": "node --test tests/artifacts/*.test.mjs",
    "build": "npm run build:packages && node scripts/combine-dist.mjs && node scripts/build-aggregate.mjs && node scripts/assemble-site.mjs",
    "build:packages": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "docs:build": "python3 -m mkdocs build --strict -f packages/nocaljs-docs/mkdocs.yml",
    "check": "npm run lint && npm test && npm run site:build && npm run test:artifacts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "site:build": "npm run build && npm run docs:build && node scripts/build-site.mjs",
    "site:preview": "http-server build/site -c-1 -p 8080",
    "release:prepare": "npm run check && node scripts/release.mjs",
    "test:release": "node --test tests/release/*.test.mjs"
  },
  "exports": {
    ".": "./dist/nocaljs-core.mjs",
    "./all": "./dist/nocaljs.mjs",
    "./core": "./dist/nocaljs-core.mjs",
    "./ui": "./dist/nocaljs-ui.mjs",
    "./config": "./dist/nocaljs-config.mjs",
    "./ext": "./dist/nocaljs-ext.mjs",
    "./cad2d-core": "./dist/nocaljs-cad2d-core.mjs",
    "./cad2d-ext": "./dist/nocaljs-cad2d-ext.mjs",
    "./css": "./dist/nocaljs.css"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.6.2 <12"
  },
  "packageManager": "npm@11.6.2",
  "files": [
    "dist"
  ]
}
